# Frontend builds use same-origin /api and need no service credentials.
# Runtime secrets belong only in /etc/th-app/runtime.env; see deploy/runtime.env.example.
# Optional root Docker Compose deployment (independent persistent volumes):
# POSTGRES_PASSWORD=replace-with-url-safe-random-database-admin-secret
# APP_DB_PASSWORD=replace-with-a-different-url-safe-runtime-secret
# PORTFOLIO_ORIGIN=https://th.io.vn
# MES_ORIGIN=https://mes.th.io.vn
# OWNER_EMAIL=eric.scorp93@gmail.com
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
