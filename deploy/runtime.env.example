DATABASE_URL=postgresql://th_api:REPLACE_WITH_RANDOM_HEX@127.0.0.1/th_app
FILES_ROOT=/var/lib/th-app/files
PORT=3000
OWNER_EMAIL=eric.scorp93@gmail.com
# Register BOTH callbacks in Google Cloud OAuth Web client:
# https://th.io.vn/api/oauth/callback
# https://mes.th.io.vn/api/oauth/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Percent-encode username/password URL characters. Use smtps:// for TLS port 465.
SMTP_URL=
MAIL_FROM=TH <noreply@th.io.vn>

# Optional Google Cloud Translation v2 API key (keep private, restrict to Translation API).
GOOGLE_TRANSLATE_API_KEY=
# Aggregate original attachment + workspace media quota (default 64 GiB).
STORAGE_QUOTA_BYTES=68719476736

# Optional; defaults preserve the existing Pi domains. Standalone launcher requires MES_ORIGIN.
# MES_ORIGIN=https://mes.th.io.vn
# PORTFOLIO_ORIGIN=https://th.io.vn
# HOST=127.0.0.1
# TRUST_PROXY=loopback
# Read access to the existing Quick Access resource folder requires re-connecting Drive.
# GOOGLE_DRIVE_SOURCE_READ=true
QUICK_ACCESS_ROOT=/opt/th-app/current/server/quick-access/site
QUICK_ACCESS_DATA_ROOT=/opt/th-app/current/server/quick-access
